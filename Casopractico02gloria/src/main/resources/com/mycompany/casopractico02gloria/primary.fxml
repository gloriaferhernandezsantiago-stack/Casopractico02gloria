<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.casopractico02gloria.PrimaryController"><children>
      <Label text="Salario base" />
      <TextField fx:id="txtSalarioBase" />
      
      <Label text="Horas extra" />
      <TextField fx:id="txtHorasExtra" />
      
      <Button text="Calcular" onAction="#btnCalcular_click" />
      
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Pago extra" prefWidth="70.0" />
            <TextField fx:id="txtPagoExtra" editable="false" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Subtotal" prefWidth="70.0" />
            <TextField fx:id="txtSubtotal" editable="false" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="ISR(16%)" prefWidth="70.0" />
            <TextField fx:id="txtIsr" editable="false" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="NETO" prefWidth="70.0" />
            <TextField fx:id="txtNeto" editable="false" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>